{
  "name": "scorehub-static",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static ScoreHUB client — talks to the existing ScoreHUB API and realtime server.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:docs": "tsc --noEmit && vite build --outDir docs",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
